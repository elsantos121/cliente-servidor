# Copiar a .env (desarrollo) y a .env.test (pruebas). Nunca subir esos archivos a Git.
# Reemplazar TU_PASSWORD por la contraseña del usuario "postgres" de tu instalación local.

# Desarrollo  -> base foro_dev
DATABASE_URL="postgresql://postgres:TU_PASSWORD@localhost:5432/foro_dev?schema=public"

# Pruebas (.env.test) -> base foro_test. El nombre DEBE terminar en _test:
# las pruebas se niegan a ejecutarse contra otra base.
# DATABASE_URL="postgresql://postgres:TU_PASSWORD@localhost:5432/foro_test?schema=public"

# Secreto para firmar los JWT (mínimo 16 caracteres; usar uno distinto en cada entorno)
JWT_SECRET="cambiar-por-un-secreto-largo-y-aleatorio"
JWT_EXPIRES_IN="2h"

PORT=3000
# Origen permitido por CORS (frontend Angular en desarrollo)
CORS_ORIGIN="http://localhost:4200"
