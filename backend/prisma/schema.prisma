// Esquema de la base de datos del foro.
// Los modelos se agregan de forma incremental, uno por historia de usuario (ver docs/historias-usuario.md),
// cada uno con su propia migración: `npx prisma migrate dev --name <descripcion>`.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// HU-01 · Registro de estudiantes
enum Rol {
  ESTUDIANTE
  ADMIN
}

model Usuario {
  id           Int      @id @default(autoincrement())
  nombre       String   @db.VarChar(100)
  /// Se guarda siempre en minúsculas: la unicidad no distingue mayúsculas.
  email        String   @unique @db.VarChar(254)
  passwordHash String   @map("password_hash")
  rol          Rol      @default(ESTUDIANTE)
  creadoEn     DateTime @default(now()) @map("creado_en")

  publicaciones Publicacion[]
  comentarios   Comentario[]
  reportes      Reporte[]

  @@map("usuarios")
}

// HU-06a · Gestión de categorías
model Categoria {
  id                Int      @id @default(autoincrement())
  nombre            String   @db.VarChar(50)
  /// Nombre recortado y en minúsculas: hace que la unicidad no distinga mayúsculas.
  nombreNormalizado String   @unique @map("nombre_normalizado") @db.VarChar(50)
  creadoEn          DateTime @default(now()) @map("creado_en")

  publicaciones Publicacion[]

  @@map("categorias")
}

// HU-03 · Publicaciones
model Publicacion {
  id            Int       @id @default(autoincrement())
  titulo        String    @db.VarChar(150)
  contenido     String    @db.Text
  autorId       Int       @map("autor_id")
  autor         Usuario   @relation(fields: [autorId], references: [id], onDelete: Restrict)
  /// RESTRICT: no se puede borrar una categoría que tiene publicaciones.
  categoriaId   Int       @map("categoria_id")
  categoria     Categoria @relation(fields: [categoriaId], references: [id], onDelete: Restrict)
  creadoEn      DateTime  @default(now()) @map("creado_en")
  actualizadoEn DateTime  @updatedAt @map("actualizado_en")

  comentarios Comentario[]
  reportes    Reporte[]

  @@index([categoriaId])
  @@index([creadoEn])
  @@map("publicaciones")
}

// HU-04 · Comentarios
model Comentario {
  id            Int         @id @default(autoincrement())
  contenido     String      @db.VarChar(2000)
  autorId       Int         @map("autor_id")
  autor         Usuario     @relation(fields: [autorId], references: [id], onDelete: Restrict)
  /// CASCADE: al borrar la publicación se borran sus comentarios (decisión de la v1).
  publicacionId Int         @map("publicacion_id")
  publicacion   Publicacion @relation(fields: [publicacionId], references: [id], onDelete: Cascade)
  creadoEn      DateTime    @default(now()) @map("creado_en")

  @@index([publicacionId])
  @@map("comentarios")
}

// HU-05 · Denuncia de publicaciones (HU-06b las modera)
enum EstadoReporte {
  PENDIENTE
  RESUELTO
  DESCARTADO
}

model Reporte {
  id            Int           @id @default(autoincrement())
  motivo        String        @db.VarChar(500)
  estado        EstadoReporte @default(PENDIENTE)
  autorId       Int           @map("autor_id")
  autor         Usuario       @relation(fields: [autorId], references: [id], onDelete: Restrict)
  /// CASCADE: al borrar la publicación se borran sus denuncias (decisión de la v1).
  publicacionId Int           @map("publicacion_id")
  publicacion   Publicacion   @relation(fields: [publicacionId], references: [id], onDelete: Cascade)
  creadoEn      DateTime      @default(now()) @map("creado_en")
  actualizadoEn DateTime      @updatedAt @map("actualizado_en")

  /// Un usuario denuncia una misma publicación una sola vez.
  @@unique([autorId, publicacionId])
  @@index([estado])
  @@map("reportes")
}
